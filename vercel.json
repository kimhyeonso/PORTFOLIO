{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/guide.js": {
      "includeFiles": "portfolio-guide-rag.text"
    }
  },
  "rewrites": [
    { "source": "/((?!api(?:/|$)|assets(?:/|$)|models(?:/|$)|.*\\.[^/]+$).*)", "destination": "/index.html" }
  ]
}
